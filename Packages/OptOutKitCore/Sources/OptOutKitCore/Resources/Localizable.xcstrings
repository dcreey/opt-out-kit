    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Diese Seite nimmt Opt-outs per E-Mail an: schreiben Sie an %@. Wir bereiten die Nachricht für Sie vor."
     }
    }
   }
  },

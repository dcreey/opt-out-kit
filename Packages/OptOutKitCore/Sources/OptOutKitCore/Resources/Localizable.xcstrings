  "Data you gave one company for one purpose is kept and sold elsewhere without you knowing.": {
   "extractionState": "manual",
   "localizations": {
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Des données confiées à une entreprise dans un but précis sont conservées et vendues ailleurs à votre insu."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Datos que diste a una empresa para un fin se guardan y se venden en otro lugar sin que lo sepas."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Daten, die Sie einer Firma für einen Zweck gegeben haben, werden behalten und ohne Ihr Wissen anderswo verkauft."
     }
    }
   }
  },

  "Loaded %@: nothing blocks the form. If the site adds a check when sending, we stop and ask you.": {
   "extractionState": "manual",
   "localizations": {
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Chargé le %@ : rien ne bloque le formulaire. Si le site ajoute une vérification à l'envoi, nous nous arrêtons et vous demandons."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Cargado el %@: nada bloquea el formulario. Si el sitio añade una verificación al enviar, nos detenemos y te preguntamos."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Am %@ geladen: Nichts blockiert das Formular. Fügt die Website beim Senden eine Prüfung hinzu, halten wir an und fragen Sie."
     }
    }
   }
  },

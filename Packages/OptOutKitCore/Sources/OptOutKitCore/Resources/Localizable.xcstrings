  "Lists an email address for requests": {
   "extractionState": "manual",
   "localizations": {
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Indique une adresse e-mail pour les demandes"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Indica una dirección de correo para las solicitudes"

  "Guesses about your health are the most personal data there is, and you cannot see or correct what they think you have.": {
   "extractionState": "manual",
   "localizations": {
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Les déductions sur votre santé sont les données les plus personnelles qui soient, et vous ne pouvez ni voir ni corriger ce qu'ils pensent de vous."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Las suposiciones sobre tu salud son los datos más personales que existen, y no puedes ver ni corregir lo que creen de ti."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Vermutungen über Ihre Gesundheit sind die persönlichsten Daten überhaupt, und Sie können nicht sehen oder korrigieren, was man über Sie denkt."
     }
    }
   }
  },

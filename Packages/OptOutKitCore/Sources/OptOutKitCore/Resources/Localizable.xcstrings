     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Suchen Sie nach einer E-Mail mit dem Betreff „%@“. "
     }
    }
   }
  },
  "Looked at %@ page(s) and found no opt-out form.": {

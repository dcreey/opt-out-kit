      "value": "Dónde vives"
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Wo Sie wohnen"
     }
    }
   }
  },
  "Where you're listed": {
   "extractionState": "manual",
   "localizations": {
    "fr": {
     "stringUnit": {

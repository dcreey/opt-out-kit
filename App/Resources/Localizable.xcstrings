  "Minors and public figures are never searched (opt-out requests still go out for them).": {
   "extractionState": "manual",
   "localizations": {
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Les mineurs et les personnalités publiques ne sont jamais recherchés (les demandes de retrait partent quand même)."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Los menores y las figuras públicas nunca se buscan (las solicitudes de baja se envían igualmente)."

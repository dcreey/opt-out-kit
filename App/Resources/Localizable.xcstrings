  },
  "What you enter is stored encrypted on this phone. If you lose your phone without a backup, it is gone. A normal iPhone backup carries it.": {
   "extractionState": "manual",
   "localizations": {
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Ce que vous saisissez est stocké chiffré sur ce téléphone. Si vous perdez votre téléphone sans sauvegarde, tout est perdu. Une sauvegarde iPhone normale le conserve."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Lo que introduces se almacena cifrado en este teléfono. Si pierdes tu teléfono sin copia de seguridad, se pierde. Una copia normal del iPhone lo conserva."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Was Sie eingeben, wird verschlüsselt auf diesem Telefon gespeichert. Verlieren Sie das Telefon ohne Backup, ist es weg. Ein normales iPhone-Backup enthält es."
     }
    }
   }
  },
  "What you would be agreeing to": {
   "extractionState": "manual",
   "localizations": {
    "fr": {
     "stringUnit": {

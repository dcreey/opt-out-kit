     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Diese Seite nimmt Opt-outs per E-Mail an: schreiben Sie an %@. Wir bereiten die Nachricht für Sie vor."
     }
    }
   }
  },
  "This site's form is written for US residents, so we take you to it and walk you through it.": {
   "extractionState": "manual",
   "localizations": {
    "fr": {
     "stringUnit": {
      "state": "translated",

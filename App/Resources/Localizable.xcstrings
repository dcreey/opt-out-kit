     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Eine geführte Anleitung mit einem Schritt per Telefon, Ausweis oder Konto"
     }
    }
   }
  },
  "A hand-written walkthrough with %@ steps.": {
   "extractionState": "manual",
   "localizations": {
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Un parcours rédigé à la main en %@ étapes."
     }
    },
    "es": {

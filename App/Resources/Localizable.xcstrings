  },
  "We found the opt-out page but could not read a form on it, so we take you there.": {
   "extractionState": "manual",
   "localizations": {
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Nous avons trouvé la page de retrait mais n'avons pas pu y lire de formulaire : nous vous y emmenons."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Encontramos la página de baja pero no pudimos leer un formulario en ella, así que te llevamos allí."
     }
    },
    "de": {

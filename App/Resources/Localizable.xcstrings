  "Required. This one address goes on every opt-out form and every data-deletion request, for you and your family.": {
   "extractionState": "manual",
   "localizations": {
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Obligatoire. Cette adresse unique figure sur chaque formulaire de retrait et chaque demande de suppression de données, pour vous et votre famille."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Obligatorio. Esta única dirección va en cada formulario de baja y en cada solicitud de eliminación de datos, para ti y tu familia."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Pflichtangabe. Diese eine Adresse steht in jedem Opt-out-Formular und jedem Löschantrag, für Sie und Ihre Familie."
     }
    }

  "Businesses in %@ must honor a universal opt-out signal such as Global Privacy Control. Turning it on in your browser helps on every site you visit.": {
   "extractionState": "manual",
   "localizations": {
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Les entreprises de %@ doivent respecter un signal universel de refus tel que Global Privacy Control. L'activer dans votre navigateur aide sur chaque site que vous visitez."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Las empresas de %@ deben respetar una señal universal de exclusión como Global Privacy Control. Activarla en tu navegador ayuda en todos los sitios que visites."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Unternehmen in %@ müssen ein universelles Opt-out-Signal wie Global Privacy Control beachten. Wenn Sie es im Browser aktivieren, hilft das auf jeder Website, die Sie besuchen."
     }
    }
   }
  },
  "California": {
   "extractionState": "manual",
   "localizations": {

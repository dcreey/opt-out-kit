    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Les courtiers en données vendent votre nom, votre adresse et vos proches. Opt-Out Kit vous guide pour vous en retirer, vous et toutes les personnes que vous ajoutez."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Los corredores de datos venden tu nombre, tu dirección y a tus familiares. Opt-Out Kit te guía para darte de baja a ti y a quien añadas."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Datenbroker verkaufen Ihren Namen, Ihre Adresse und Ihre Angehörigen. Opt-Out Kit führt Sie dabei, sich und alle, die Sie hinzufügen, daraus zu entfernen."
     }
    }
   }
  },

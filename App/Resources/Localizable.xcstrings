  "NSUserTrackingUsageDescription": {
   "extractionState": "manual",
   "localizations": {
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Certains courtiers de données désinscrivent votre téléphone grâce à son identifiant publicitaire. Exnay le lit uniquement pour le leur donner lors de votre désinscription et ne le conserve jamais."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Algunos intermediarios de datos dan de baja tu teléfono con su identificador de publicidad. Exnay lo lee solo para dárselo cuando te das de baja y nunca lo guarda."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Manche Datenhändler tragen Ihr Telefon anhand seiner Werbe-ID aus. Exnay liest sie nur, um sie beim Austragen an diese weiterzugeben, und speichert sie nie."
     }
    }
   }
  },

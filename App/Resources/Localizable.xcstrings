  },
  "Opt-out forms use the email address on your own profile. Add it there first.": {
   "extractionState": "manual",
   "localizations": {
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Les formulaires de retrait utilisent l'adresse e-mail de votre propre profil. Ajoutez-la d'abord là."
     }
    },
    "es": {
     "stringUnit": {

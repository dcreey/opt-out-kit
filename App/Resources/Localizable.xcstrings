   "localizations": {
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Vos informations ne quittent jamais ce téléphone, sauf vers les sites dont vous vous retirez. Il n'y a ni serveur Opt-Out Kit, ni compte, ni analyse, ni suivi."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Tu información nunca sale de este teléfono, salvo hacia los sitios de los que te das de baja. No hay servidor de Opt-Out Kit, ni cuenta, ni analíticas, ni seguimiento."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Ihre Informationen verlassen dieses Telefon nie, außer zu den Websites, bei denen Sie sich abmelden. Es gibt keinen Opt-Out-Kit-Server, kein Konto, keine Analyse und kein Tracking."
     }

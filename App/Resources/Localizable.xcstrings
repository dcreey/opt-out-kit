    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Lien du site"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Enlace del sitio"
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Link zur Website"
     }
    }
   }
  },
  "Sites": {
   "extractionState": "manual",
   "localizations": {
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Sites"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Sitios"
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Websites"
     }
    }
   }
  },
  "Sites find and remove records by legal name and address, so every profile needs both. Only the fields a site's form asks for are ever sent.": {
   "extractionState": "manual",
   "localizations": {
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Les sites trouvent et suppriment les fiches par nom légal et adresse : chaque profil a donc besoin des deux. Seuls les champs demandés par le formulaire d'un site sont envoyés."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Los sitios encuentran y eliminan registros por nombre legal y dirección, así que cada perfil necesita ambos. Solo se envían los campos que pide el formulario de un sitio."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Websites finden und entfernen Einträge anhand von rechtlichem Namen und Adresse, daher braucht jedes Profil beides. Gesendet werden nur die Felder, die das Formular einer Website verlangt."
     }
    }
   }
  },
  "Sites in this message": {
   "extractionState": "manual",
   "localizations": {
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Sites de ce message"
     }
    },
    "es": {

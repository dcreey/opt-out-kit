    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Was Sie eingeben, wird verschlüsselt auf diesem Telefon gespeichert. Verlieren Sie das Telefon ohne Backup, ist es weg. Ein normales iPhone-Backup enthält es."
     }
    }

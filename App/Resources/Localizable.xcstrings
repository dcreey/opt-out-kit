  "Accepting does not cost money. The prompts and terms I read have no fee, subscription or arbitration clause.": {
   "extractionState": "manual",
   "localizations": {
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Accepter ne coûte rien. Les fenêtres et conditions que j'ai lues ne prévoient ni frais, ni abonnement, ni clause d'arbitrage."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Aceptar no cuesta dinero. Los avisos y términos que leí no tienen tarifa, suscripción ni cláusula de arbitraje."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Das Akzeptieren kostet nichts. In den Hinweisen und Bedingungen, die ich gelesen habe, gibt es keine Gebühr, kein Abo und keine Schiedsklausel."
     }
    }
   }
  },

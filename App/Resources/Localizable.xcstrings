  "Stored encrypted on this phone. There is no server and no account; the app contacts only the broker sites you opt out of.": {
   "extractionState": "manual",
   "localizations": {
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Stocké chiffré sur ce téléphone. Il n'y a ni serveur ni compte ; l'appli ne contacte que les sites de courtiers dont vous vous retirez."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Almacenado cifrado en este teléfono. No hay servidor ni cuenta; la app solo contacta con los sitios de corredores de los que te das de baja."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Verschlüsselt auf diesem Telefon gespeichert. Es gibt weder Server noch Konto; die App kontaktiert nur die Broker-Websites, bei denen Sie sich abmelden."
     }
    }
   }
  },

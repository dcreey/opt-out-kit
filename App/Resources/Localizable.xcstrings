     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Diese Seite hat %lld Opt-out-Formulare. Wir senden jedes: Formular %lld von %lld."
     }
    }
   }
  },
  "This page mentions an email": {
   "extractionState": "manual",
   "localizations": {

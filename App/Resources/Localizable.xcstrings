  "Use it lawfully only. No stalking or harassing anyone, and no using a false identity to get information.": {
   "extractionState": "manual",
   "localizations": {
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "N'utilisez-le que légalement. Pas de harcèlement ni de traque, et pas d'usurpation d'identité pour obtenir des informations."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Úsalo solo de forma legal. Nada de acoso ni persecución, ni usar una identidad falsa para obtener información."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Nutzen Sie es nur rechtmäßig. Kein Stalking oder Belästigen und keine falsche Identität, um an Informationen zu kommen."
     }
    }
   }
  },

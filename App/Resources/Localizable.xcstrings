  "The guide stays at the top of the screen and the site's own page sits below it.": {
   "extractionState": "manual",
   "localizations": {
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Le guide reste en haut de l’écran et la page du site se trouve en dessous."
     }
    },
    "es": {

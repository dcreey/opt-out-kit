  "Tap Profile to enter your legal name and current address (both required), plus any other names and past addresses.": {
   "extractionState": "manual",
   "localizations": {
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Touchez Profil pour saisir votre nom légal et votre adresse actuelle (obligatoires), ainsi que d'autres noms et d'anciennes adresses."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",

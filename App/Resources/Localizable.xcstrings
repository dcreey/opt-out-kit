     "stringUnit": {
      "state": "translated",
      "value": "Einigen Quellen zufolge müssen Unternehmen in %@ universelle Opt-out-Signale wie Global Privacy Control beachten. Es im Browser zu aktivieren kostet nichts."
     }
    }
   }

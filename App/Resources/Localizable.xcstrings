    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Les résultats ne sont pas prouvés. Une fiche trouvée ici peut être fausse : Opt-Out Kit la traite comme une piste, pas comme une preuve."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Los resultados no están probados. Una ficha encontrada aquí puede ser errónea, así que Opt-Out Kit la trata como una pista, no como una prueba."

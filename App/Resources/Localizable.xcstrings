  "Terms that ban or imply automated access": {
   "extractionState": "manual",
   "localizations": {
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Conditions qui interdisent ou laissent entendre l'accès automatisé"
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",

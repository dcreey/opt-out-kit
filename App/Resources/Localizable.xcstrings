      "value": "Seiten in dieser Nachricht"
     }
    }
   }
  },
  "Sites in this run (%lld)": {
   "extractionState": "manual",
   "localizations": {
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Sites de cette exécution (%lld)"
     }
    },
    "es": {

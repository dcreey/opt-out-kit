  "Smaller manual tasks for brokers registered where you live or in your country.": {
   "extractionState": "manual",
   "localizations": {
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Tâches manuelles plus petites pour des courtiers enregistrés chez vous ou dans votre pays."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Tareas manuales más pequeñas para intermediarios registrados donde vives o en tu país."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Kleinere manuelle Aufgaben für Händler, die bei Ihnen oder in Ihrem Land registriert sind."
     }
    }
   }
  },
  "So far, by kind of broker": {
   "extractionState": "manual",

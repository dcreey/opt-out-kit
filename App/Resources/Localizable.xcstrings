  "Loaded %@: nothing blocked the form. We fill it in and send it; you tick any check the site shows. A confirmed real run would make it automatic.": {
   "extractionState": "manual",
   "localizations": {
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Chargé le %@ : rien ne bloquait le formulaire. Nous le remplissons et l’envoyons ; vous cochez toute vérification affichée. Une exécution réelle confirmée le rendrait automatique."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Cargado el %@: nada bloqueaba el formulario. Lo rellenamos y enviamos; tú marcas cualquier verificación que muestre. Una ejecución real confirmada lo haría automático."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Geladen am %@: Nichts blockierte das Formular. Wir füllen es aus und senden es; Sie haken jede angezeigte Prüfung an. Ein bestätigter echter Durchlauf würde es automatisch machen."
     }
    }
   }
  },
  "Loaded %@: nothing blocks the form. If a check ever appears when sending, this site moves to semi-automated.": {
   "extractionState": "manual",
   "localizations": {
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Chargé le %@ : rien ne bloque le formulaire. Si une vérification apparaît un jour à l’envoi, ce site passe en semi-automatisé."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Cargado el %@: nada bloquea el formulario. Si alguna vez aparece una verificación al enviar, este sitio pasa a semiautomático."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Geladen am %@: Nichts blockiert das Formular. Erscheint beim Senden doch eine Prüfung, wird diese Seite halbautomatisch."
     }
    }
   }
  },
  "Loaded %@: nothing blocks the form. If the site adds a check when sending, we stop and ask you.": {
   "extractionState": "manual",
   "localizations": {
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Chargé le %@ : rien ne bloque le formulaire. Si le site ajoute une vérification à l'envoi, nous nous arrêtons et vous demandons."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",

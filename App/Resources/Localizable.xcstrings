  "Off unless you turn it on. It never accepts terms that ban automated access, and every acceptance is logged here on this phone.": {
   "extractionState": "manual",
   "localizations": {
    "fr": {
     "stringUnit": {
      "state": "translated",
      "value": "Désactivé sauf si vous l'activez. Elle n'accepte jamais de conditions qui interdisent l'accès automatisé, et chaque acceptation est consignée ici, sur ce téléphone."
     }
    },
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Desactivado salvo que lo actives. Nunca acepta términos que prohíban el acceso automatizado, y cada aceptación se registra aquí, en este teléfono."
     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Aus, solange Sie es nicht einschalten. Sie akzeptiert nie Bedingungen, die automatisierten Zugriff verbieten, und jede Zustimmung wird hier auf diesem Telefon protokolliert."
     }
    }
   }
  },

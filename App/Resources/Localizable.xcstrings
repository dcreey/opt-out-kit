     }
    },
    "de": {
     "stringUnit": {
      "state": "translated",
      "value": "Das Geburtsdatum weist auf unter 18 hin, daher wird dieses Profil als minderjährig behandelt."
     }
    }
   }
  },
  "The email link expires quickly": {
   "extractionState": "manual",

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Opt-Out Kit directory entry (generated)",
  "type": "object",
  "required": ["id", "domain", "name", "bucket", "automation"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "languages": {
      "description": "The languages the site is offered in, and its opt-out page in each (tools/regional_sites.py)",
      "type": "object", "additionalProperties": false, "required": ["list", "pages"],
      "properties": {
        "list": { "type": "array", "items": { "type": "string" } },
        "pages": { "type": "object", "additionalProperties": { "type": "string" } },
        "checked": { "type": ["string", "null"] }
      }
    },
    "regional_sites": {
      "description": "The site's own sites for other countries (tools/regional_sites.py)",
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["region", "url", "how"],
        "properties": {
          "region": { "type": "string" },
          "url": { "type": "string" },
          "how": { "type": "string" },
          "privacy_page": { "type": ["string", "null"] },
          "has_form": { "type": ["boolean", "null"] }
        }
      }
    },
    "no_fill": { "description": "Nothing of the person's is filled in: the app shows the page only", "type": "boolean" },
    "find_later": { "description": "No page or email found yet: to be found by hand", "type": "boolean" },
    "domain": { "type": "string", "minLength": 3 },
    "name": { "type": "string" },
    "bucket": { "enum": ["direct", "indirect", "registry"] },
    "tier": { "enum": ["A", "B", "C", "D", null] },
    "automation": { "enum": ["scriptable", "guided", "needs_browser", "blocked", "robots_disallowed", "unreachable", "unknown"] },
    "confidence": { "type": "string" },
    "opt_out_url": { "type": ["string", "null"] },
    "opt_out_form": {
      "type": "object",
      "required": ["page", "method", "fields", "hops"],
      "additionalProperties": false,
      "properties": {
        "page": { "type": "string" },
        "method": { "type": "string" },
        "action": { "type": "string" },
        "hops": { "type": "integer", "minimum": 0 },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "name", "label"],
            "additionalProperties": false,
            "properties": { "type": { "type": "string" }, "name": { "type": "string" }, "label": { "type": "string" } }
          }
        }
      }
    },
    "family": { "type": "string" },
    "family_parent": { "type": "string" },
    "template": { "type": "string" },
    "registered_in": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z]{2}$" } },
    "contact_email": { "type": "string" },
    "contact_email_source": { "enum": ["page", "policy", "browser"] },
    "priority": { "type": "integer", "minimum": 0, "maximum": 100 },
    "about": {
      "type": "object",
      "required": ["category", "summary"],
      "additionalProperties": false,
      "properties": {
        "category": { "type": "string" },
        "summary": { "type": "string" },
        "tracks": { "type": "array", "items": { "type": "string" } },
        "sells_to": { "type": "array", "items": { "type": "string" } },
        "sells_note": { "type": "string" },
        "source": { "type": "string" }
      }
    },
    "regions": {"type": "object", "required": ["list"], "properties": {"list": {"type": "array", "items": {"type": "string"}}, "evidence": {"type": "string"}, "checked": {"type": "string"}}},
    "persistence": {
      "type": "object",
      "required": ["result"],
      "additionalProperties": false,
      "properties": {
        "result": { "enum": ["permanent", "temporary", "unknown"] },
        "reup_months": { "type": "integer", "minimum": 1, "maximum": 24 },
        "quote": { "type": "string" },
        "source": { "type": "string" }
      }
    },
    "caution": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["biometric"] },
        "note": { "type": "string" },
        "sources": { "type": "array", "items": { "type": "string" } }
      }
    },
    "excluded": {
      "type": "object",
      "required": ["checked", "kind", "reason"],
      "additionalProperties": false,
      "properties": {
        "checked": { "type": "string" },
        "kind": { "enum": ["business_only", "not_a_data_broker"] },
        "reason": { "type": "string" }
      }
    },
    "closed": {
      "type": "object",
      "required": ["checked", "evidence"],
      "additionalProperties": false,
      "properties": {
        "checked": { "type": "string" },
        "evidence": { "type": "array", "items": { "type": "string" } }
      }
    },
    "live_form": {
      "type": "object",
      "required": ["checked", "found"],
      "additionalProperties": false,
      "properties": {
        "checked": { "type": "string" },
        "found": { "type": "boolean" },
        "page": { "type": "string" },
        "blockers": { "type": "array", "items": { "type": "string" } }
      }
    },
    "run_check": {
      "type": "object",
      "required": ["date", "result"],
      "additionalProperties": false,
      "properties": {
        "date": { "type": "string" },
        "result": { "enum": ["confirmed", "failed"] },
        "note": { "type": "string" }
      }
    },
    "live_check": {
      "type": "object",
      "required": ["checked", "blockers"],
      "additionalProperties": false,
      "properties": {
        "checked": { "type": "string" },
        "blockers": { "type": "array", "items": { "type": "string" } }
      }
    },
    "search_check": {
      "type": "object",
      "required": ["status"],
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["calibrated", "blocked", "robots_disallowed", "undifferentiated", "needs_post", "needs_browser", "no_search", "terms_gate"] },
        "search_url": { "type": "string" },
        "valid_page": { "type": "array", "items": { "type": "string" } },
        "no_results": { "type": "array", "items": { "type": "string" } },
        "ignore_location": { "type": "boolean" },
        "method": { "enum": ["GET", "POST"] },
        "needs_browser": { "type": "boolean" },
        "candidate": {
          "type": "object",
          "required": ["method", "url"],
          "additionalProperties": false,
          "properties": { "method": { "enum": ["GET", "POST"] }, "url": { "type": "string" }, "body": { "type": ["string", "null"] } }
        },
        "body": { "type": "string" },
        "calibration": { "type": "object" },
        "checked": { "type": "string" }
      }
    },
    "signals": { "type": "array", "items": { "type": "string" } },
    "profiled": { "type": "string" }
  }
}

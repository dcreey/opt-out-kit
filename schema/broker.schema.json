{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Opt-Out Kit broker definition",
  "type": "object",
  "required": ["id", "name", "tier", "steps", "recheck_days"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "name": { "type": "string", "minLength": 1 },
    "tier": { "enum": ["A", "B", "C", "D"] },
    "covers": { "type": "array", "items": { "type": "string" } },
    "signals": { "type": "array", "items": { "type": "string" } },
    "fields": { "type": "array", "items": { "type": "string" } },
    "recheck_days": { "type": "integer", "minimum": 1 },
    "verified": { "type": ["string", "null"] },
    "processing_days": { "type": "integer", "minimum": 0 },
    "recheck": {
      "type": "object",
      "required": ["search_url", "valid_page"],
      "additionalProperties": false,
      "properties": {
        "search_url": { "type": "string" },
        "valid_page": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "no_results": { "type": "array", "items": { "type": "string" } },
        "needs_browser": { "type": "boolean" },
        "ignore_location": { "type": "boolean" },
        "calibration": {
          "type": "object",
          "required": ["listed_name"],
          "additionalProperties": false,
          "properties": {
            "listed_name": { "type": "string" },
            "city": { "type": "string" },
            "state": { "type": "string" }
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "open": { "type": "string", "format": "uri" },
          "copy": { "type": "string" },
          "say": { "type": "string" },
          "search_match": { "type": "string" },
          "confirm": { "type": "boolean" },
          "done_when": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "url_contains": { "type": "string" },
              "text_contains": { "type": "string" },
              "url_changes": { "type": "boolean" }
            }
          },
          "wait_for_email": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "subject": { "type": "string" },
              "within_minutes": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    }
  }
}
